{
  "name": "@healthcare/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:proof": "tsx scripts/db-proof.ts"
  },
  "dependencies": {
    "@healthcare/shared": "*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
