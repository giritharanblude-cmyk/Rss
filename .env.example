# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata

# Database (Neon pooled connection string, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Origin protection (Netlify proxy sends this header; must match on the VM)
ORIGIN_SECRET=replace-with-long-random-value
# Set to true in production. Local dev may set false only via this flag.
ORIGIN_SECRET_ENFORCED=false

# Session signing
JWT_SECRET=replace-with-long-random-value

# Single master user seed (Phase 1)
MASTER_NAME=Admin
MASTER_PASSWORD=replace-with-strong-password
MASTER_EMAIL=admin@example.com

# Hostinger SMTP (Phase 1/5)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@example.com
SMTP_PASSWORD=replace-with-mailbox-password
MAIL_FROM_NAME=Healthcare News Desk
MAIL_FROM_EMAIL=admin@example.com

# WhatsApp / OpenWA (Phase 5)
OPENWA_SESSION_ID=healthcare-news
OPENWA_HEADLESS=true
CHROME_PATH=/usr/bin/chromium
WHATSAPP_SEND_MIN_INTERVAL_MS=3000
WHATSAPP_SEND_MAX_INTERVAL_MS=5000

# Retention and polling
RETENTION_NEWS_DAYS=90
RETENTION_DELIVERIES_DAYS=180
DASHBOARD_POLL_INTERVAL_MS=5000
DASHBOARD_POLL_INTERVAL_HIDDEN_MS=10000
