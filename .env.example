# Copy to .env and fill in placeholders. Never commit .env or real secrets.

# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
# Production requires an absolute public URL and rejects localhost.
PUBLIC_APP_ORIGIN=replace-with-public-https-url

# Required by the API; production should use a PostgreSQL connection string with sslmode=require.
DATABASE_URL=replace-with-postgresql-connection-string

# Production-only origin protection. ORIGIN_SECRET must be at least 16 characters.
# Set ORIGIN_SECRET_ENFORCED=true in production; development may leave it false.
ORIGIN_SECRET=replace-with-origin-secret
ORIGIN_SECRET_ENFORCED=false

# Required session-signing secret; at least 32 characters.
JWT_SECRET=replace-with-jwt-secret

# API startup requires at least one of MASTER_EMAIL or MAIL_FROM_EMAIL.
MASTER_NAME=replace-with-master-name
MASTER_PASSWORD=replace-with-master-password
# If set, this must be a valid email address.
MASTER_EMAIL=replace-with-master-email

# Optional SMTP configuration.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-mailbox-username
SMTP_PASSWORD=replace-with-mailbox-password
MAIL_FROM_NAME=replace-with-sender-name
# If set, this must be a valid email address; it can satisfy the API email requirement above.
MAIL_FROM_EMAIL=replace-with-sender-email

# Required encryption key: 64 hexadecimal characters or Base64 encoding of exactly 32 bytes.
# Keep the production value in a secret manager; do not commit a real key.
SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-key

# WhatsApp / OpenWA (Phase 5)
# OpenWA runs separately; set this to its reachable HTTP(S) socket URL.
OPENWA_SOCKET_URL=replace-with-openwa-socket-url
OPENWA_API_KEY=replace-with-openwa-api-key
CHROME_PATH=/usr/bin/chromium

# Retention and polling
RETENTION_NEWS_DAYS=90
RETENTION_DELIVERIES_DAYS=180
DASHBOARD_POLL_INTERVAL_MS=5000
DASHBOARD_POLL_INTERVAL_HIDDEN_MS=10000
